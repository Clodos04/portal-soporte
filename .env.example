# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.
PORT=80

# BD principal (tickets, usuarios, buzón)
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=sav
DB_PORT=3306

# BD Centinela (usar un usuario de SOLO LECTURA, no root)
CENTINELA_HOST=
CENTINELA_USER=
CENTINELA_PASSWORD=
CENTINELA_DB=Centinela
CENTINELA_PORT=3306

# Sesiones: genera un valor largo y aleatorio, ej: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_HORAS=12
# Pon true solo si el portal se sirve por HTTPS
COOKIE_SECURE=false
# Orígenes externos permitidos separados por coma (normalmente vacío: el portal usa el mismo origen)
CORS_ORIGIN=

# Carpeta de adjuntos: en Easypanel debe ser un volumen PERMANENTE (ej. /app/uploads) o se pierden al redesplegar
UPLOADS_DIR=
ADJUNTO_MAX_MB=10
